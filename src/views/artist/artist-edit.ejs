<%- contentFor('HeaderCss') %>
    <%- contentFor('body') %>
        <div class="row">
            <div class="col-xl-12">
                <%- include ('../partials/messages') %>
                    <form action="/artist/update/<%=artist.id%>" method="post" enctype="multipart/form-data">
                        <div class="card">
                            <div class="card-body">
                                <div class="d-flex">
                                    <div class="flex-grow-1 ms-2">
                                        <div class="mb-3">
                                            <div class="card-body">
                                                <div class="row gy-4">
                                                    <div class="col-md-6">
                                                        <label for="name" class="form-label">Name</label>
                                                        <input type="text" class="form-control" id="title" name="name" value="<%= artist.name%>">
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label for="slug" class="form-label">Slug</label>
                                                        <input type="text" class="form-control" id="slug" name="slug" value="<%= artist.slug%>">
                                                    </div>
                                                    <div class="col-12">
                                                        <label for="bio" class="form-label">Bio</label>
                                                        <textarea name="bio" id="bio" class="form-control" rows="5"><%=artist.bio%></textarea>
                                                    </div>
                                                    <div class="col-12">
                                                        <label for="genre" class="form-label">Genre</label>
                                                        <textarea name="genre" id="genre" class="form-control" rows="5"><%=artist.genre%></textarea>
                                                    </div>
                                                    <!-- Cover Image -->
                                                    <div class="col-12">
                                                        <label for="coverImage">Cover Image</label>
                                                        <div
                                                            class="drop-image border border-2 border-secondary border-dashed rounded p-4 text-center"
                                                            data-name="coverImage"
                                                            data-existing-image="/<%=artist.coverImage%>"
                                                            style="cursor: pointer;">

                                                            <div class="upload-content">
                                                                <i class="fa-solid fa-cloud-arrow-up fs-1 text-secondary"></i>
                                                                <p class="mb-1 mt-2">Drag & drop your image here</p>
                                                                <small class="text-muted">or click to select</small>
                                                            </div>

                                                            <input
                                                                type="file"
                                                                class="image-input"
                                                                name="coverImage"
                                                                accept="image/*"
                                                                hidden>

                                                            <div class="preview-content d-none mt-3">
                                                                <img
                                                                    class="image-preview img-fluid rounded"
                                                                    src=""
                                                                    alt="Image Preview"
                                                                    style="max-height: 250px; display: none;">

                                                                <div class="mt-2 d-flex justify-content-center align-items-center gap-2">
                                                                    <span class="image-name small text-truncate"></span>
                                                                    <span class="image-size small text-muted"></span>
                                                                    <button type="button" class="remove-image btn btn-sm btn-outline-danger">
                                                                        <i class="fa-solid fa-xmark"></i> Remove
                                                                    </button>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <!-- Image -->
                                                    <div class="col-12">
                                                        <label for="image">Image</label>
                                                        <div
                                                            class="drop-image border border-2 border-secondary border-dashed rounded p-4 text-center"
                                                            data-name="image"
                                                            data-existing-image="/<%=artist.image%>"
                                                            style="cursor: pointer;">

                                                            <div class="upload-content">
                                                                <i class="fa-solid fa-cloud-arrow-up fs-1 text-secondary"></i>
                                                                <p class="mb-1 mt-2">Drag & drop your image here</p>
                                                                <small class="text-muted">or click to select</small>
                                                            </div>

                                                            <input
                                                                type="file"
                                                                class="image-input"
                                                                name="image"
                                                                accept="image/*"
                                                                hidden>

                                                            <div class="preview-content d-none mt-3">
                                                                <img
                                                                    class="image-preview img-fluid rounded"
                                                                    src=""
                                                                    alt="Image Preview"
                                                                    style="max-height: 250px; display: none;">

                                                                <div class="mt-2 d-flex justify-content-center align-items-center gap-2">
                                                                    <span class="image-name small text-truncate"></span>
                                                                    <span class="image-size small text-muted"></span>
                                                                    <button type="button" class="remove-image btn btn-sm btn-outline-danger">
                                                                        <i class="fa-solid fa-xmark"></i> Remove
                                                                    </button>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div class="col-12">
                                                        <label for="content" class="form-label">Content</label>
                                                        <textarea name="content" id="content" class="form-control"
                                                            rows="5"><%=artist.content%></textarea>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div><!-- end card-body -->
                        </div><!-- end card -->

                        <div class="card card-body">
                            <button type="submit" class="btn btn-secondary waves-effect col-md-3">Submit</button>
                        </div>
                    </form>
            </div><!-- end col -->
        </div><!-- end row -->

        <%- contentFor('FooterJs') %>
            <script src="/assets/js/main/tinymce.js"></script>
            <script src="/assets/js/main/addCommon.js"></script>
            <script defer src="/assets/js/main/drop-and-drag-img.js"></script>