<%- contentFor('HeaderCss') %>
<link href="/assets/libs/sweetalert2/sweetalert2.min.css" rel="stylesheet" type="text/css" />
<%- contentFor('body') %>
<div class="row">
  <div class="col-lg-12">
    <%- include ('../partials/messages') %>
    <div class="card" id="customerList">
      <div class="card-header border-bottom-dashed">

        <div class="row g-4 align-items-center">
          <div class="col-sm">
            <div>
              <h5 class="card-title mb-0">Site Icons</h5>
            </div>
          </div>
        </div>
      </div>
      <div class="card-body">
        <div class="accordion" id="iconAccordion">
          <% if(icons && icons.length > 0) { %>
              <% icons.forEach((icon, index) => { %>
                  <div class="accordion-item icon-item mb-2" id="icon-item-<%= index %>">
                      <h2 class="accordion-header" id="iconHeading<%= index %>">
                          <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#iconCollapse<%= index %>" aria-expanded="false" aria-controls="iconCollapse<%= index %>">
                              <%= icon.title %>
                          </button>
                      </h2>
                      <div id="iconCollapse<%= index %>" class="accordion-collapse collapse" aria-labelledby="iconHeading<%= index %>" data-bs-parent="#iconAccordion">
                          <div class="accordion-body">
                              <form action="/site-icons/update/<%= icon.id %>" method="POST" class="icon-update-form">
                                  <div class="mb-3">
                                      <img src="/<%= icon.imagePath %>" class="img-fluid mb-3" style="height: 100px;" alt="<%= icon.title %>">
                                  </div>
                                  <div class="mb-3">
                                      <label class="form-label">Title</label>
                                      <input type="text" class="form-control icon-title" name="title" value="<%= icon.title %>" required>
                                  </div>
                                  <div class="text-end">
                                      <button type="submit" class="btn btn-primary btn-sm me-2">Update</button>
                                      <button type="button" class="btn btn-danger btn-sm" onclick="deleteSiteIcon('<%= icon.id %>', 'image-item-<%= index %>')">Delete Icon</button>
                                  </div>
                              </form>
                          </div>
                      </div>
                  </div>
              <% }) %>
          <% } %>
      </div>
      <div class="mt-3">
          <form action="/site-icons/upload" method="POST" enctype="multipart/form-data" id="addImageForm">
            <div class="row gy-4">
              <div class="col-12">
                <label for="siteIcon" class="form-label">Site Icon</label>
                <input type="file" class="form-control" id="siteIcon" name="siteIcon" accept="image/*" onchange="previewSingleImage(event)">
              </div>
            
              <div id="imagePreviewContainer" class="row mt-3">
                <!-- Image preview and title input will appear here -->
              </div>
            
              <div class="col-12">
                <div class="alert alert-info">
                  <small>
                    Upload a site icon. You can specify a title with top-logo, bottom-logo, favicon, etc.
                  </small>
                </div>
              </div>
            
              <div class="text-end mt-3">
                <button type="submit" class="btn btn-secondary">Upload Icon</button>
              </div>
            </div>
          </form>
      </div>
       </div>
    </div>

  </div>
  <!--end col-->
</div>
<!--end row-->

<%- contentFor('FooterJs') %>

<!-- list.js min js -->
<script src="/assets/libs/list.js/list.min.js"></script>
<script src="/assets/libs/list.pagination.js/list.pagination.min.js"></script>

<!--ecommerce-customer init js -->
<script src="/assets/js/pages/ecommerce-customer-list.init.js"></script>
<script src="/assets/libs/sweetalert2/sweetalert2.min.js"></script>
<!-- App js -->
<script src="/assets/js/main/multiImagePreview.js"></script>
<script>
  function deleteSiteIcon(iconId, elementId) {
    if(confirm('Are you sure you want to delete this icon?')) {
        fetch(`/site-icons/delete/${iconId}`, {
            method: 'POST',
        })
        .then(response => response.json())
        .then(data => {
            if(data.success) {
                document.getElementById(elementId).remove();
                window.location.reload();
            } 
        })
        .catch(error => {
            console.error('Error:', error);
            window.location.reload();
        });
    }
}

function previewSingleImage(event) {
  const file = event.target.files[0];
  const previewContainer = document.getElementById('imagePreviewContainer');
  previewContainer.innerHTML = ''; // Clear existing preview

  if (file && file.type.startsWith('image/')) {
    const reader = new FileReader();
    reader.onload = function (e) {
      const html = `
        <div class="col-12 mb-3 icon-details">
          <div class="card">
            <div class="card-body d-flex align-items-center">
              <img src="${e.target.result}" alt="Icon Preview" class="me-3" style=" height: 100px; object-fit: cover; border-radius: 8px;">
              <div class="flex-grow-1">
                <label class="form-label">Title</label>
                <input type="text" class="form-control" name="title" required>
              </div>
            </div>
          </div>
        </div>`;
      previewContainer.innerHTML = html;
    };
    reader.readAsDataURL(file);
  }
}
</script>