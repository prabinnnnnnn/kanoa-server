<%- contentFor('HeaderCss') %>
<link href="/assets/libs/sweetalert2/sweetalert2.min.css" rel="stylesheet" type="text/css" />
<%- contentFor('body') %>
<div class="row">
  <div class="col-lg-12">
    <%- include ('../partials/messages') %>
    <div class="card" id="customerList">
      <div class="card-header border-bottom-dashed">

        <div class="row g-4 align-items-center">
          <div class="col-sm">
            <div>
              <h5 class="card-title mb-0">Sliders</h5>
            </div>
          </div>
          <div class="col-sm-auto">
            <div class="d-flex flex-wrap align-items-start gap-2">
              <button class="btn btn-soft-danger" id="remove-actions" onClick="deleteMultiple()"><i class="ri-delete-bin-2-line"></i></button>
              <button type="button" class="btn btn-success add-btn" data-bs-toggle="modal" data-bs-target="#createSliderModal"><i class="ri-add-line align-bottom me-1"></i> New Slider</button>
            </div>
          </div>
        </div>
      </div>
      <div class="card-body border-bottom-dashed border-bottom">
        <form>
          <div class="row g-3">
            <div class="col-xl-6">
              <div class="search-box">
                <input type="text" class="form-control search" placeholder="Search here...">
                <i class="ri-search-line search-icon"></i>
              </div>
            </div>
            <!--end col-->
            <div class="col-xl-6">
              <div class="row g-3">
                <div class="col-sm-4">
                </div>
                <!--end col-->
                <div class="col-sm-4">
                  <div>
                  </div>
                </div>
                <!--end col-->

                <div class="col-sm-4">
                  <div>
                  </div>
                </div>
                <!--end col-->
              </div>
            </div>
          </div>
          <!--end row-->
        </form>
      </div>
      <div class="card-body">
        <div>
          <div class="table-responsive table-card mb-1">
            <table class="table align-middle" id="customerTable">
              <thead class="table-light text-muted">
                <tr>
                  <th scope="col" style="width: 50px;">
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" id="checkAll" value="option">
                    </div>
                  </th>
                  <th class="" data-sort="imagePath">Image</th>
                  <th class="sort" data-sort="title">Title</th>
                  <th class="sort" data-sort="altText">Alt Text</th>
                  <th class="sort" data-sort="link">Link</th>
                  <th class="sort" data-sort="isActive">Status</th>
                  <th class="sort" data-sort="sortOrder">Order</th>
                  <th class="sort" data-sort="action">Action</th>
                </tr>
              </thead>
              <tbody class="list form-check-all">
                <% if (sliders && sliders.length > 0) { %>
                    <% sliders.forEach(slider => { %>
                        <tr>
                            <th scope="row">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="chk_child" value="<%= slider.id %>">
                                </div>
                            </th>
                            <td class="imagePath">
                              <img src="<%= slider.imagePath %>" alt="<%= slider.title %>" class="img-thumbnail" style="width: 100px;">
                            </td>
                            <td class="title"><%= slider.title %></td>
                            <td class="altText"><%= slider.altText %></td>
                            <td class="link">
                              <a href="<%= slider.link %>" target="_blank">
                                <%= slider.link %>
                              </a>
                            </td>
                            <td class="isActive">
                              <span class="badge bg-<%= slider.isActive ? 'success' : 'danger' %>-subtle text-<%= slider.isActive ? 'success' : 'danger' %> text-uppercase">
                                  <%= slider.isActive ? "Active" : "Inactive" %>
                                </span>
                            </td>                            
                            <td class="sortOrder"><%= slider.sortOrder %></td>
                            <td>
                                <ul class="list-inline hstack gap-2 mb-0">
                                    <li class="list-inline-item edit" data-bs-toggle="tooltip" data-bs-trigger="hover" data-bs-placement="top" title="Edit">
                                        <a class="text-primary d-inline-block edit-item-btn" data-bs-toggle="modal" href="#updateSliderModal" 
                                        data-id="<%= slider.id %>"
                                        data-title="<%= slider.title %>"
                                        data-alt-text="<%= slider.altText %>"
                                        data-description="<%= slider.description %>"
                                        data-link="<%= slider.link %>"
                                        data-is-active="<%= slider.isActive %>"
                                        data-sort-order="<%= slider.sortOrder %>"
                                        data-image-path="<%= slider.imagePath %>"
                                        >
                                            <i class="ri-pencil-fill fs-16"></i>
                                        </a>
                                    </li>
                                    <li class="list-inline-item" data-bs-toggle="tooltip" data-bs-trigger="hover" data-bs-placement="top" title="Remove">
                                        <a class="text-danger d-inline-block remove-item-btn" data-bs-toggle="modal" href="#deleteRecordModal" data-id="<%= slider.id %>">
                                            <i class="ri-delete-bin-5-fill fs-16"></i>
                                        </a>
                                    </li>
                                </ul>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="8" class="text-center">No sliders found</td>
                    </tr>
                <% } %>
              </tbody>
            </table>
            <div class="noresult" style="display: none">
              <div class="text-center">
                <lord-icon src="https://cdn.lordicon.com/msoeawqm.json" trigger="loop" colors="primary:#121331,secondary:#08a88a" style="width:75px;height:75px"></lord-icon>
                <h5 class="mt-2">Sorry! No Result Found</h5>
              </div>
            </div>
          </div>
          <div class="d-flex justify-content-end">
            <div class="pagination-wrap hstack gap-2">
              <a class="page-item pagination-prev disabled" href="#">
                Previous
              </a>
              <ul class="pagination listjs-pagination mb-0"></ul>
              <a class="page-item pagination-next" href="#">
                Next
              </a>
            </div>
          </div>
        </div>

        <!-- Modal -->
        <div class="modal fade zoomIn" id="deleteRecordModal" tabindex="-1" aria-hidden="true">
          <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
              <div class="modal-header">
                <button type="button" class="btn-close" id="deleteRecord-close" data-bs-dismiss="modal" aria-label="Close" id="btn-close"></button>
              </div>
              <div class="modal-body">
                <div class="mt-2 text-center">
                  <lord-icon src="https://cdn.lordicon.com/gsqxdxog.json" trigger="loop" colors="primary:#f7b84b,secondary:#f06548" style="width:100px;height:100px"></lord-icon>
                  <div class="mt-4 pt-2 fs-15 mx-4 mx-sm-5">
                    <h4>Are you sure ?</h4>
                    <p class="text-muted mx-4 mb-0">Are you sure you want to remove this record ?</p>
                  </div>
                </div>
                <div class="d-flex gap-2 justify-content-center mt-4 mb-2">
                  <button type="button" class="btn w-sm btn-light" data-bs-dismiss="modal">Close</button>
                  <form action="" method="POST" id="deleteForm">
                    <button type="submit" class="btn w-sm btn-danger" id="delete-record">Yes, Delete It!</button>
                  </form>
                </div>
              </div>
            </div>
          </div>
        </div>
        <!--end modal -->


        <div class="modal fade" id="updateSliderModal" tabindex="-1" aria-labelledby="updateSliderModalLabel" aria-hidden="true">
          <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
              <div class="modal-header">
                <h5 class="modal-title" id="updateSliderModalLabel">Update Slider</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <form action="/sliders/update" method="POST" enctype="multipart/form-data" id="updateSliderForm">
                <input type="hidden" id="updateSliderId" name="id">
                <div class="mb-3">
                  <label for="updateTitle" class="form-label">Title</label>
                  <input type="text" class="form-control" id="updateTitle" name="title" >
                </div>
                <div class="mb-3">
                  <label for="updateAltText" class="form-label">Alt Text</label>
                  <input type="text" class="form-control" id="updateAltText" name="altText" >
                </div>
                <div class="mb-3">
                  <label for="updateDescription" class="form-label">Description</label>
                  <input type="text" class="form-control" id="updateDescription" name="description" >
                </div>
                <div class="mb-3">
                  <label for="updateLink" class="form-label">Link</label>
                  <input type="text" class="form-control" id="updateLink" name="link" >
                </div>
                <div class="mb-3">
                  <label for="updateIsActive" class="form-label">Status</label>
                  <select class="form-select" id="updateIsActive" name="isActive" required>
                    <% if (typeof slider !== 'undefined' && slider) { %>
                      <option value="true" <%= slider.isActive ? 'selected' : '' %>>Active</option>
                      <option value="false" <%= !slider.isActive ? 'selected' : '' %>>Inactive</option>
                    <% } else { %>
                      <option value="true">Active</option>
                      <option value="false">Inactive</option>
                    <% } %>
                  </select>
                </div>

                <div class="mb-3">
                  <label for="updateSortOrder" class="form-label">Order</label>
                  <input type="number" class="form-control" id="updateSortOrder" name="sortOrder" required>
                </div>

                <div class="mb-3">
                  <label for="updateImage" class="form-label">Image</label>
                  <input type="file" class="form-control" id="updateImage" name="image">
                  <div class="mt-2" id="currentImagePreview">
                    <img src="" alt="Current Review Image" class="img-thumbnail" style="max-width: 200px; display: none;">
                  </div>
                </div>
                <div class="modal-footer">
                  <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
                  <button type="submit" class="btn btn-primary">Update Slider</button>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>

      <div class="modal fade" id="createSliderModal" tabindex="-1" aria-labelledby="createSliderModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title" id="createSliderModalLabel">Add New Slider</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <form action="/sliders/create" method="POST" enctype="multipart/form-data">
                <div class="mb-3">
                  <label for="title" class="form-label">Title</label>
                  <input type="text" class="form-control" id="title" name="title" required>
                </div>
                <div class="mb-3">
                  <label for="altText" class="form-label">Alt Text</label>
                  <input type="text" class="form-control" id="altText" name="altText" required>
                </div>
                <div class="mb-3">
                  <label for="description" class="form-label">Description</label>
                  <input type="text" class="form-control" id="description" name="description" >
                </div>
                <div class="mb-3">
                  <label for="link" class="form-label">Link</label>
                  <input type="text" class="form-control" id="link" name="link" >
                </div>
                <div class="mb-3">
                  <label for="isActive" class="form-label">Status</label>
                  <select class="form-select" id="isActive" name="isActive" required>
                    <option value="true">Active</option>
                    <option value="false">Inactive</option>
                  </select>
                </div>
                <div class="mb-3">
                  <label for="sortOrder" class="form-label">Order</label>
                  <input type="number" class="form-control" id="sortOrder" name="sortOrder" required>
                </div>
                <div class="mb-3">
                  <label for="image" class="form-label">Image</label>
                  <input type="file" class="form-control" id="image" name="image" required>
                </div>
                <div class="modal-footer">
                  <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
                  <button type="submit" class="btn btn-primary">Create Slider</button>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
      </div>
    </div>

  </div>
  <!--end col-->
</div>
<!--end row-->

<%- contentFor('FooterJs') %>

<!-- list.js min js -->
<script src="/assets/libs/list.js/list.min.js"></script>
<script src="/assets/libs/list.pagination.js/list.pagination.min.js"></script>

<!--ecommerce-customer init js -->
<script src="/assets/js/pages/ecommerce-customer-list.init.js"></script>
<script src="/assets/libs/sweetalert2/sweetalert2.min.js"></script>
<!-- App js -->

<script>
  document.addEventListener('DOMContentLoaded', function() {
      document.querySelectorAll('.remove-item-btn').forEach(btn => {
          btn.addEventListener('click', function() {
              const idToDelete = this.dataset.id;
              document.getElementById("deleteForm").action = "/sliders/delete/" + idToDelete;
          });
      });

    function updateSliderModal(sliderData) {
      document.getElementById('updateSliderId').value = sliderData.id;
      document.getElementById('updateTitle').value = sliderData.title;
      document.getElementById('updateAltText').value = sliderData.altText;
      document.getElementById('updateDescription').value = sliderData.description;
      document.getElementById('updateLink').value = sliderData.link;
      document.getElementById('updateIsActive').value = sliderData.isActive;
      document.getElementById('updateSortOrder').value = sliderData.sortOrder;

      // Handle image preview
      const imagePreview = document.querySelector('#currentImagePreview img');
      if (sliderData.imagePath) {
        imagePreview.src = '/' + sliderData.imagePath;
        imagePreview.style.display = 'block';
      } else {
        imagePreview.style.display = 'none';
      }
    }

    // Add click handlers to edit buttons
    document.querySelectorAll('.edit-item-btn').forEach(button => {
      button.addEventListener('click', function() {
        const sliderData = {
          id: this.dataset.id,
          title: this.dataset.title,
          altText: this.dataset.altText,
          description: this.dataset.description,
          link: this.dataset.link,
          isActive: this.dataset.isActive,
          sortOrder: this.dataset.sortOrder,
          imagePath: this.dataset.imagePath
        };
        updateSliderModal(sliderData);
      });
    });
  });
</script>