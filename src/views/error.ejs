<%- contentFor('HeaderCss') %>
<%- contentFor('body') %>

<!-- auth-page wrapper -->
<div class="auth-page-wrapper py-5 d-flex justify-content-center align-items-center min-vh-100">

  <!-- auth-page content -->
  <div class="auth-page-content overflow-hidden p-0">
    <div class="container-fluid">
      <div class="row justify-content-center">
        <div class="col-xl-4 text-center">
          <lord-icon class="avatar-xl" src="https://cdn.lordicon.com/etwtznjn.json" trigger="loop" colors="primary:#405189,secondary:#0ab39c">
          </lord-icon>
          <div>
            <h1>Something Wrong!</h1>
            <p class="text-muted w-75 mx-auto"><%= error %></p>
            <a href="/" class="btn btn-success"><i class="mdi mdi-home me-1"></i>Back to home</a>
          </div>
        </div><!-- end col-->
      </div>
      <!-- end row -->
    </div>
    <!-- end container -->
  </div>
  <!-- end auth-page content -->
</div>
<!-- end auth-page-wrapper -->

<%- contentFor('FooterJs') %>