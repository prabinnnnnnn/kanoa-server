<% if (messages.error) { %>
<div
  class="alert alert-danger alert-border-left alert-dismissible fade show"
  role="alert"
>
  <i class="ri-error-warning-line me-3 align-middle"></i>
  <%= messages.error %>
  <button
    type="button"
    class="btn-close"
    data-bs-dismiss="alert"
    aria-label="Close"
  ></button>
</div>
<% } %> <% if (messages.success) { %>
<div
  class="alert alert-success alert-border-left alert-dismissible fade show"
  role="alert"
>
  <i class="ri-checkbox-circle-line me-3 align-middle"></i>
  <%= messages.success %>
  <button
    type="button"
    class="btn-close"
    data-bs-dismiss="alert"
    aria-label="Close"
  ></button>
</div>
<% } %>
