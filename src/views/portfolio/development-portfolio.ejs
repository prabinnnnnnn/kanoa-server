<%- contentFor('HeaderCss') %>
    <link href="/assets/libs/sweetalert2/sweetalert2.min.css" rel="stylesheet" type="text/css" />
    <%- contentFor('body') %>
        <div class="row">
            <div class="col-lg-12">
                <%- include ('../partials/messages') %>
                    <div class="card" id="customerList">
                        <div class="card-header border-bottom-dashed">
                            <div class="row g-4 align-items-center">
                                <div class="col-sm">
                                    <div>
                                        <h5 class="card-title mb-0">
                                            <%=page_title%>
                                        </h5>
                                    </div>
                                </div>
                                <div class="col-sm-auto">
                                    <div class="d-flex flex-wrap align-items-start gap-2">
                                        <a href="/portfolio-development/create" class="btn btn-success add-btn" id="create-btn"><i
                                                class="ri-add-line align-bottom me-1"></i> New
                                            Development</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card-body border-bottom-dashed border-bottom">
                            <form>
                                <div class="row g-3">
                                    <div class="col-xl-6">
                                        <div class="search-box">
                                            <input type="text" class="form-control search" placeholder="Search here...">
                                            <i class="ri-search-line search-icon"></i>
                                        </div>
                                    </div>
                                    <!--end col-->
                                    <div class="col-xl-6">
                                        <div class="row g-3">
                                            <div class="col-sm-4">
                                            </div>
                                            <!--end col-->
                                            <div class="col-sm-4">
                                                <div>
                                                </div>
                                            </div>
                                            <!--end col-->

                                            <div class="col-sm-4">
                                                <div>
                                                </div>
                                            </div>
                                            <!--end col-->
                                        </div>
                                    </div>
                                </div>
                                <!--end row-->
                            </form>
                        </div>
                        <div class="card-body">
                            <div>
                                <div class="table-responsive table-card mb-1">
                                    <table class="table align-middle" id="customerTable">
                                        <thead class="table-light text-muted">
                                            <tr>
                                                <th scope="col" style="width: 50px;">
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="checkbox" id="checkAll" value="option">
                                                    </div>
                                                </th>

                                                <th class="sort" data-sort="imagePath">Image</th>
                                                <th class="sort" data-sort="altText">Title</th>
                                                <th class="sort" data-sort="altText">Service</th>
                                                <th class="sort" data-sort="action">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody class="list form-check-all">
                                            <% if (developments && developments.length> 0) { %>
                                                <% developments.forEach(design=> { %>
                                                    <tr>
                                                        <th scope="row">
                                                            <div class="form-check">
                                                                <input class="form-check-input" type="checkbox" name="chk_child"
                                                                    value="<%= design.id %>">
                                                            </div>
                                                        </th>
                                                        <td class="imagePath"><img src="<%= design.imagePath %>" alt="<%= design.altText %>"
                                                                style="width: 90px;">
                                                        </td>
                                                        <td class="altText">
                                                            <%= design.title %>
                                                        </td>
                                                        <td class="url">
                                                            <span>
                                                                <%= design.service.title %>
                                                            </span>
                                                            </a>
                                                        </td>
                                                        <td>
                                                            <ul class="list-inline hstack gap-2 mb-0">
                                                                <li class="list-inline-item edit" data-bs-toggle="tooltip" data-bs-trigger="hover"
                                                                    data-bs-placement="top" title="Edit">
                                                                    <a href="/portfolio-development/edit/<%= design.id %>"
                                                                        class="text-primary d-inline-block edit-item-btn">
                                                                        <i class="ri-pencil-fill fs-16"></i>
                                                                    </a>
                                                                </li>
                                                                <li class="list-inline-item" data-bs-toggle="tooltip" data-bs-trigger="hover"
                                                                    data-bs-placement="top" title="Remove">
                                                                    <a class="text-danger d-inline-block remove-item-btn" data-bs-toggle="modal"
                                                                        href="#deleteRecordModal" data-id="<%= design.id %>">
                                                                        <i class="ri-delete-bin-5-fill fs-16"></i>
                                                                    </a>
                                                                </li>
                                                            </ul>
                                                        </td>
                                                    </tr>
                                                    <% }); %>
                                                        <% } else { %>
                                                            <tr>
                                                                <td colspan="8" class="text-center">No developments
                                                                    found</td>
                                                            </tr>
                                                            <% } %>
                                        </tbody>
                                    </table>
                                    <div class="noresult" style="display: none">
                                        <div class="text-center">
                                            <lord-icon src="https://cdn.lordicon.com/msoeawqm.json" trigger="loop"
                                                colors="primary:#121331,secondary:#08a88a" style="width:75px;height:75px"></lord-icon>
                                            <h5 class="mt-2">Sorry! No Result Found</h5>
                                        </div>
                                    </div>
                                </div>
                                <div class="d-flex justify-content-end">
                                    <div class="pagination-wrap hstack gap-2">
                                        <a class="page-item pagination-prev disabled" href="#">
                                            Previous
                                        </a>
                                        <ul class="pagination listjs-pagination mb-0"></ul>
                                        <a class="page-item pagination-next" href="#">
                                            Next
                                        </a>
                                    </div>
                                </div>
                            </div>

                            <!-- Modal -->
                            <div class="modal fade zoomIn" id="deleteRecordModal" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <button type="button" class="btn-close" id="deleteRecord-close" data-bs-dismiss="modal"
                                                aria-label="Close" id="btn-close"></button>
                                        </div>
                                        <div class="modal-body">
                                            <div class="mt-2 text-center">
                                                <lord-icon src="https://cdn.lordicon.com/gsqxdxog.json" trigger="loop"
                                                    colors="primary:#f7b84b,secondary:#f06548" style="width:100px;height:100px"></lord-icon>
                                                <div class="mt-4 pt-2 fs-15 mx-4 mx-sm-5">
                                                    <h4>Are you sure ?</h4>
                                                    <p class="text-muted mx-4 mb-0">Are you sure you want to remove
                                                        this
                                                        record ?</p>
                                                </div>
                                            </div>
                                            <div class="d-flex gap-2 justify-content-center mt-4 mb-2">
                                                <button type="button" class="btn w-sm btn-light" data-bs-dismiss="modal">Close</button>
                                                <form action="" method="POST" id="deleteForm">
                                                    <button type="submit" class="btn w-sm btn-danger" id="delete-record">Yes, Delete
                                                        It!</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!--end modal -->


                            <div class="modal fade" id="updateClientModal" tabindex="-1" aria-labelledby="updateClientModalLabel"
                                aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered modal-lg">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title" id="updateClientModalLabel">Update Client</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                                            </button>
                                        </div>
                                        <div class="modal-body">
                                            <form action="" method="POST" enctype="multipart/form-data" id="updateForm">
                                                <ul class="nav nav-tabs nav-tabs-custom nav-success nav-justified mb-3" role="tablist">
                                                    <li class="nav-item">
                                                        <a class="nav-link active" data-bs-toggle="tab" href="#blogContent" role="tab">
                                                            <i class="ri-pages-line align-middle me-1"></i> Details
                                                        </a>
                                                    </li>
                                                    <li class="nav-item">
                                                        <a class="nav-link" data-bs-toggle="tab" href="#seo" role="tab">
                                                            <i class="ri-file-search-line align-middle me-1"></i>
                                                            About
                                                            Client
                                                        </a>
                                                    </li>
                                                    <li class="nav-item">
                                                        <a class="nav-link" data-bs-toggle="tab" href="#contents" role="tab">
                                                            <i class="ri-file-search-line align-middle me-1"></i>
                                                            contents
                                                        </a>
                                                    </li>
                                                </ul>
                                                <div class="tab-content">
                                                    <div class="tab-pane active" id="blogContent" role="tabpanel">
                                                        <input type="hidden" id="updateClientId" name="id">
                                                        <div class="col-12 mb-3">
                                                            <label for="serviceId" class="form-label">Service</label>
                                                            <select class="form-select" id="serviceId" name="serviceId" required>
                                                                <% service.forEach(function(category) { %>
                                                                    <option value="<%= category.id %>">
                                                                        <%= category.title %>
                                                                    </option>
                                                                    <% }); %>
                                                            </select>
                                                        </div>
                                                        <div class="row">
                                                            <div class="mb-3 col-6">
                                                                <label for="updateTitle" class="form-label">Title</label>
                                                                <input type="text" class="form-control" id="updateTitle" name="title" required>
                                                            </div>
                                                            <div class="mb-3 col-6">
                                                                <label for="updateSlug" class="form-label">slug</label>
                                                                <input type="text" class="form-control" id="updateSlug" name="slug" required>
                                                            </div>
                                                        </div>
                                                        <div class="mb-3">
                                                            <label for="updateDescription" class="form-label">Description</label>
                                                            <textarea rows="5" type="text" class="form-control" id="updateDescription"
                                                                name="description" required>
                                                            </textarea>
                                                        </div>
                                                        <div class="row">
                                                            <div class="mb-3 col-6">
                                                                <label for="updateTags" class="form-label">Tags</label>
                                                                <input type="text" class="form-control" id="updateTags" name="tags" required>
                                                            </div>
                                                            <div class="mb-3 col-6">
                                                                <label for="updateAltText" class="form-label">Alt
                                                                    Text</label>
                                                                <input type="text" class="form-control" id="updateAltText" name="altText">
                                                            </div>
                                                        </div>
                                                        <div class="mb-3">
                                                            <label for="updateLink" class="form-label">Link</label>
                                                            <input type="text" class="form-control" id="updateLink" name="url">
                                                        </div>
                                                        <div class="mb-3">
                                                            <label for="updateImage" class="form-label">Image</label>
                                                            <input type="file" class="form-control" id="updateImage" name="imagePath">
                                                            <div class="mt-2" id="currentImagePreview">
                                                                <img src="" alt="Current Review Image" class="img-thumbnail"
                                                                    style="max-width: 200px; display: none;">
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div class="tab-pane" id="seo" role="tabpanel">
                                                        <div class="row gy-4">
                                                            <div class="col-6">
                                                                <label for="coverImage" class="form-label">Website
                                                                    Demo
                                                                    Image</label>
                                                                <input type="file" class="form-control" id="coverImage" name="coverImage"
                                                                    accept="image/*">
                                                                <div class="mt-2" id="coverImagePreview">
                                                                    <img src="" alt="Current Review Image" class="img-thumbnail"
                                                                        style="max-width: 200px; display: none;">
                                                                </div>
                                                            </div>
                                                            <div class="col-6">
                                                                <label for="clientImage" class="form-label">client
                                                                    Image</label>
                                                                <input type="file" class="form-control" id="clientImage" name="clientImage"
                                                                    accept="image/*">
                                                                <div class="mt-2" id="clientImagePreview">
                                                                    <img src="" alt="Current Review Image" class="img-thumbnail"
                                                                        style="max-width: 200px; display: none;">
                                                                </div>
                                                            </div>
                                                            <div class="col-md-12">
                                                                <label for="clientDescription" class="form-label">Description</label>
                                                                <textarea class="form-control" id="clientDescription" name="client[description]"
                                                                    rows="8"></textarea>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div class="tab-pane" id="contents" role="tabpanel">
                                                        <div class="d-flex">
                                                            <div class="flex-grow-1 ms-2">
                                                                <div class="mb-4">
                                                                    <form id="faqForm" action="/blogs/update-faqs" method="post">
                                                                        <div class="accordion" id="faqAccordion">
                                                                            <% if(developments && developments.length> 0) { %>
                                                                                <% developments.forEach((faq, index)=> { %>
                                                                                    <div class="accordion-item faq-item mb-2" id="faq-item-<%= index %>">
                                                                                        <h2 class="accordion-header" id="heading<%= index %>">
                                                                                            <button class="accordion-button collapsed" type="button"
                                                                                                data-bs-toggle="collapse" data-bs-target="#collapse<%= index %>"
                                                                                                aria-expanded="false" aria-controls="collapse<%= index %>">
                                                                                                <%= faq.question %>
                                                                                            </button>
                                                                                        </h2>
                                                                                        <div id="collapse<%= index %>" class="accordion-collapse collapse"
                                                                                            aria-labelledby="heading<%= index %>" data-bs-parent="#faqAccordion">
                                                                                            <div class="accordion-body">
                                                                                                <div class="mb-3">
                                                                                                    <label class="form-label">Question</label>
                                                                                                    <input type="text" class="form-control faq-question"
                                                                                                        name="faqs[<%= index %>][question]" value="<%= faq.question %>"
                                                                                                        required>
                                                                                                </div>
                                                                                                <div class="mb-3">
                                                                                                    <label class="form-label">Answer</label>
                                                                                                    <textarea class="form-control faq-answer"
                                                                                                        name="faqs[<%= index %>][answer]" rows="3"
                                                                                                        required><%= faq.answer %></textarea>
                                                                                                </div>
                                                                                                <div class="mb-3">
                                                                                                    <label class="form-label">Sort
                                                                                                        Order</label>
                                                                                                    <input type="number" class="form-control faq-sort"
                                                                                                        name="faqs[<%= index %>][sortOrder]" value="<%= faq.sortOrder %>"
                                                                                                        required>
                                                                                                </div>
                                                                                                <input type="hidden" name="faqs[<%= index %>][id]"
                                                                                                    value="<%= faq.id %>">
                                                                                                <div class="text-end">
                                                                                                    <button type="button" class="btn btn-danger btn-sm"
                                                                                                        onclick="removeFaqItem('faq-item-<%= index %>')">Remove
                                                                                                        FAQ</button>
                                                                                                </div>
                                                                                            </div>
                                                                                        </div>
                                                                                    </div>
                                                                                    <% }) %>
                                                                                        <% } %>
                                                                        </div>

                                                                        <div id="newFaqContainer"></div>

                                                                        <div class="text-center mt-3 mb-3">
                                                                            <button type="button" class="btn btn-soft-primary waves-effect"
                                                                                onclick="addNewFaqItem()">
                                                                                <i class="ri-add-line align-middle me-1"></i> Add New Contents
                                                                            </button>
                                                                        </div>
                                                                    </form>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
                                                    <button type="submit" class="btn btn-primary">Update
                                                        Client</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="modal fade" id="createClientModal" tabindex="-1" aria-labelledby="createClientModalLabel"
                                aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered modal-lg">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title" id="createClientModalLabel">Add New Development
                                            </h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body">
                                            <form action="/portfolio-development/create" method="post" enctype="multipart/form-data">
                                                <div class="mb-3">
                                                    <label for="service" class="form-label">Service Category</label>
                                                    <select class="form-select" id="service" name="serviceId" required>
                                                        <option value="" selected disabled>Select...</option>
                                                        <% service.forEach(function(category) { %>
                                                            <option value="<%= category.id %>">
                                                                <%= category.title %>
                                                            </option>
                                                            <% }); %>
                                                    </select>
                                                </div>
                                                <div class="mb-3">
                                                    <label for="title" class="form-label">Title</label>
                                                    <input type="text" class="form-control" id="title" name="title" required>
                                                </div>
                                                <div class="mb-3">
                                                    <label for="description" class="form-label">Description</label>
                                                    <input type="text" class="form-control" id="description" name="description" required>
                                                </div>
                                                <div class="mb-3">
                                                    <label for="tags" class="form-label">Tags</label>
                                                    <input type="text" class="form-control" id="tags" name="tags" required>
                                                </div>
                                                <div class="mb-3">
                                                    <label for="link" class="form-label">Link</label>
                                                    <input type="text" class="form-control" id="link" name="url">
                                                </div>
                                                <div class="mb-3">
                                                    <label for="altText" class="form-label">Alt Text</label>
                                                    <input type="text" class="form-control" id="altText" name="altText" required>
                                                </div>
                                                <div class="mb-3">
                                                    <label for="image" class="form-label">Image</label>
                                                    <input type="file" class="form-control" id="image" name="imagePath" required>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
                                                    <button type="submit" class="btn btn-primary">Create
                                                        Design</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

            </div>
            <!--end col-->
        </div>
        <!--end row-->

        <%- contentFor('FooterJs') %>
            <script src="/assets/js/main/addCommon.js"></script>
            <!-- list.js min js -->
            <script src="/assets/libs/list.js/list.min.js"></script>
            <script src="/assets/libs/list.pagination.js/list.pagination.min.js"></script>

            <!--ecommerce-customer init js -->
            <script src="/assets/js/pages/ecommerce-customer-list.init.js"></script>
            <script src="/assets/libs/sweetalert2/sweetalert2.min.js"></script>
            <!-- App js -->

            <script>
                document.addEventListener('DOMContentLoaded', function () {
                    document.querySelectorAll('.remove-item-btn').forEach(btn => {
                        btn.addEventListener('click', function () {
                            const idToDelete = this.dataset.id;
                            document.getElementById("deleteForm").action = "/portfolio-development/delete/" + idToDelete;
                        });
                    });
                });

            </script>