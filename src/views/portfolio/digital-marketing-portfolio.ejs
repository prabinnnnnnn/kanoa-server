<%- contentFor('HeaderCss') %>
    <link href="/assets/libs/sweetalert2/sweetalert2.min.css" rel="stylesheet" type="text/css" />
    <%- contentFor('body') %>
        <div class="row">
            <div class="col-lg-12">
                <%- include ('../partials/messages') %>
                    <div class="card" id="customerList">
                        <div class="card-header border-bottom-dashed">

                            <div class="row g-4 align-items-center">
                                <div class="col-sm">
                                    <h5 class="card-title mb-0">
                                        <%=page_title%>
                                    </h5>
                                </div>
                                <div class="col-sm-auto">
                                    <div class="d-flex flex-wrap align-items-start gap-2">
                                        <a href="/portfolio-marketing/create" class="btn btn-success add-btn" id="create-btn">
                                            <i class="ri-add-line align-bottom me-1"></i>
                                            New Marketing
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card-body border-bottom-dashed border-bottom">
                            <div class="row g-3">
                                <div class="col-xl-6">
                                    <div class="search-box">
                                        <input type="text" class="form-control search" placeholder="Search here...">
                                        <i class="ri-search-line search-icon"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card-body">
                            <div>
                                <div class="table-responsive table-card mb-1">
                                    <table class="table align-middle" id="customerTable">
                                        <thead class="table-light text-muted">
                                            <tr>
                                                <th scope="col" style="width: 50px;">
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="checkbox" id="checkAll" value="option">
                                                    </div>
                                                </th>

                                                <th class="sort" data-sort="imagePath">Image</th>
                                                <th class="sort" data-sort="altText">title</th>
                                                <th class="sort" data-sort="link">Link</th>
                                                <th class="sort" data-sort="service">Service</th>
                                                <th class="sort" data-sort="action">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody class="list form-check-all">
                                            <% if (digitals && digitals.length> 0) { %>
                                                <% digitals.forEach(design=> { %>
                                                    <tr>
                                                        <th scope="row">
                                                            <div class="form-check">
                                                                <input class="form-check-input" type="checkbox" name="chk_child"
                                                                    value="<%= design.id %>">
                                                            </div>
                                                        </th>
                                                        <td class="imagePath"><img src="<%= design.imagePath %>" alt="<%= design.altText %>"
                                                                style="width: 50px;"></td>
                                                        <td class="altText">
                                                            <%= design.title%>
                                                        </td>
                                                        <td class="link">
                                                            <a href="<%= design.link %>" target="_blank">
                                                                <%= design.url %>
                                                            </a>
                                                        </td>
                                                        <td class="url">
                                                            <span>
                                                                <%= design.service.title %>
                                                            </span>
                                                            </a>
                                                        </td>
                                                        <td>
                                                            <ul class="list-inline hstack gap-2 mb-0">
                                                                <li class="list-inline-item edit" data-bs-toggle="tooltip" data-bs-trigger="hover"
                                                                    data-bs-placement="top" title="Edit">
                                                                    <a href="/portfolio-marketing/edit/<%= design.id %>"
                                                                        class="text-primary d-inline-block edit-item-btn">
                                                                        <i class="ri-pencil-fill fs-16"></i>
                                                                    </a>
                                                                </li>
                                                                <li class="list-inline-item" data-bs-toggle="tooltip" data-bs-trigger="hover"
                                                                    data-bs-placement="top" title="Remove">
                                                                    <a class="text-danger d-inline-block remove-item-btn" data-bs-toggle="modal"
                                                                        href="#deleteRecordModal" data-id="<%= design.id %>">
                                                                        <i class="ri-delete-bin-5-fill fs-16"></i>
                                                                    </a>
                                                                </li>
                                                            </ul>
                                                        </td>
                                                    </tr>
                                                    <% }); %>
                                                        <% } else { %>
                                                            <tr>
                                                                <td colspan="8" class="text-center">No digitals found</td>
                                                            </tr>
                                                            <% } %>
                                        </tbody>
                                    </table>
                                    <div class="noresult" style="display: none">
                                        <div class="text-center">
                                            <lord-icon src="https://cdn.lordicon.com/msoeawqm.json" trigger="loop"
                                                colors="primary:#121331,secondary:#08a88a" style="width:75px;height:75px"></lord-icon>
                                            <h5 class="mt-2">Sorry! No Result Found</h5>
                                        </div>
                                    </div>
                                </div>
                                <div class="d-flex justify-content-end">
                                    <div class="pagination-wrap hstack gap-2">
                                        <a class="page-item pagination-prev disabled" href="#">
                                            Previous
                                        </a>
                                        <ul class="pagination listjs-pagination mb-0"></ul>
                                        <a class="page-item pagination-next" href="#">
                                            Next
                                        </a>
                                    </div>
                                </div>
                            </div>

                            <!-- Modal -->
                            <div class="modal fade zoomIn" id="deleteRecordModal" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <button type="button" class="btn-close" id="deleteRecord-close" data-bs-dismiss="modal"
                                                aria-label="Close" id="btn-close"></button>
                                        </div>
                                        <div class="modal-body">
                                            <div class="mt-2 text-center">
                                                <lord-icon src="https://cdn.lordicon.com/gsqxdxog.json" trigger="loop"
                                                    colors="primary:#f7b84b,secondary:#f06548" style="width:100px;height:100px"></lord-icon>
                                                <div class="mt-4 pt-2 fs-15 mx-4 mx-sm-5">
                                                    <h4>Are you sure ?</h4>
                                                    <p class="text-muted mx-4 mb-0">Are you sure you want to remove this record ?</p>
                                                </div>
                                            </div>
                                            <div class="d-flex gap-2 justify-content-center mt-4 mb-2">
                                                <button type="button" class="btn w-sm btn-light" data-bs-dismiss="modal">Close</button>
                                                <form action="" method="POST" id="deleteForm">
                                                    <button type="submit" class="btn w-sm btn-danger" id="delete-record">Yes, Delete It!</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="modal fade" id="updateClientModal" tabindex="-1" aria-labelledby="updateClientModalLabel" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered modal-lg">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title" id="updateClientModalLabel">Update Client</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body">
                                            <form action="" method="POST" enctype="multipart/form-data" id="updateForm">
                                                <div class="row">
                                                    <input type="hidden" id="updateClientId" name="id">
                                                    <div class="col-12 mb-3">
                                                        <label for="serviceId" class="form-label">Service</label>
                                                        <select class="form-select" id="serviceId" name="serviceId" required>
                                                            <% service.forEach(function(category) { %>
                                                                <option value="<%= category.id %>">
                                                                    <%= category.title %>
                                                                </option>
                                                                <% }); %>
                                                        </select>
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="updateTitle" class="form-label">Title</label>
                                                        <input type="text" class="form-control" id="updateTitle" name="title" required>
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="updateDescription" class="form-label">Description</label>
                                                        <input type="text" class="form-control" id="updateDescription" name="description" required>
                                                    </div>
                                                    <div class="mb-3 col-md-6">
                                                        <label for="updateBeforeTraffic" class="form-label">Before Traffic</label>
                                                        <input type="number" class="form-control" id="updateBeforeTraffic" name="before_traffic"
                                                            required>
                                                    </div>
                                                    <div class="mb-3 col-md-6">
                                                        <label for="updateAfterTraffic" class="form-label">After Traffic</label>
                                                        <input type="number" class="form-control" id="updateAfterTraffic" name="after_traffic"
                                                            required>
                                                    </div>
                                                    <div class="mb-3 col-md-6">
                                                        <label for="updateBeforeRank" class="form-label">Before Rank</label>
                                                        <input type="number" class="form-control" id="updateBeforeRank" name="before_rank" required>
                                                    </div>
                                                    <div class="mb-3 col-md-6">
                                                        <label for="updateAfterRank" class="form-label">After Rank</label>
                                                        <input type="number" class="form-control" id="updateAfterRank" name="after_rank" required>
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="updateAltText" class="form-label">Alt Text</label>
                                                        <input type="text" class="form-control" id="updateAltText" name="altText">
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="updateLink" class="form-label">Link</label>
                                                        <input type="text" class="form-control" id="updateLink" name="url">
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="updateImage" class="form-label">Image</label>
                                                        <input type="file" class="form-control" id="updateImage" name="imagePath">
                                                        <div class="mt-2" id="currentImagePreview">
                                                            <img src="" alt="Current Review Image" class="img-thumbnail"
                                                                style="max-width: 200px; display: none;">
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
                                                        <button type="submit" class="btn btn-primary">Update Client</button>
                                                    </div>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="modal fade" id="createClientModal" tabindex="-1" aria-labelledby="createClientModalLabel"
                                aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered modal-lg">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title" id="createClientModalLabel">Add New Marketing Project </h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body">
                                            <form action="/portfolio-marketing/create" method="POST" enctype="multipart/form-data">
                                                <div class="row">
                                                    <div class="mb-3">
                                                        <label for="service" class="form-label">Service Category</label>
                                                        <select class="form-select" id="service" name="serviceId" required>
                                                            <option value="" selected disabled>Select...</option>
                                                            <% service.forEach(function(category) { %>
                                                                <option value="<%= category.id %>">
                                                                    <%= category.title %>
                                                                </option>
                                                                <% }); %>
                                                        </select>
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="title" class="form-label">Title</label>
                                                        <input type="text" class="form-control" id="title" name="title" required>
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="description" class="form-label">Description</label>
                                                        <input type="text" class="form-control" id="description" name="description" required>
                                                    </div>
                                                    <div class="mb-3 col-md-6">
                                                        <label for="before-traffic" class="form-label">Before Traffic</label>
                                                        <input type="number" class="form-control" id="before-traffic" name="before_traffic"
                                                            required>
                                                    </div>
                                                    <div class="mb-3 col-md-6">
                                                        <label for="after-traffic" class="form-label">After Traffic</label>
                                                        <input type="number" class="form-control" id="after-traffic" name="after_traffic" required>
                                                    </div>
                                                    <div class="mb-3 col-md-6">
                                                        <label for="before-rank" class="form-label">Before Rank</label>
                                                        <input type="number" class="form-control" id="before-rank" name="before_rank" required>
                                                    </div>
                                                    <div class="mb-3 col-md-6">
                                                        <label for="after-rank" class="form-label">After Rank</label>
                                                        <input type="number" class="form-control" id="after-rank" name="after_rank" required>
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="link" class="form-label">Link</label>
                                                        <input type="text" class="form-control" id="link" name="url">
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="altText" class="form-label">Alt Text</label>
                                                        <input type="text" class="form-control" id="altText" name="altText" required>
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="image" class="form-label">Image</label>
                                                        <input type="file" class="form-control" id="image" name="imagePath" required>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
                                                        <button type="submit" class="btn btn-primary">Create Design</button>
                                                    </div>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

            </div>
            <!--end col-->
        </div>
        <!--end row-->

        <%- contentFor('FooterJs') %>

            <!-- list.js min js -->
            <script src="/assets/libs/list.js/list.min.js"></script>
            <script src="/assets/libs/list.pagination.js/list.pagination.min.js"></script>

            <!--ecommerce-customer init js -->
            <script src="/assets/js/pages/ecommerce-customer-list.init.js"></script>
            <script src="/assets/libs/sweetalert2/sweetalert2.min.js"></script>
            <!-- App js -->

            <script>
                document.addEventListener('DOMContentLoaded', function () {
                    document.querySelectorAll('.remove-item-btn').forEach(btn => {
                        btn.addEventListener('click', function () {
                            const idToDelete = this.dataset.id;
                            document.getElementById("deleteForm").action = "/portfolio-marketing/delete/" + idToDelete;
                        });
                    });

                    function updateClientModal(clientData) {
                        document.getElementById('updateClientId').value = clientData.id;
                        document.getElementById('updateTitle').value = clientData.title;
                        document.getElementById('updateDescription').value = clientData.description;
                        document.getElementById('updateBeforeTraffic').value = clientData.beforeTraffic;
                        document.getElementById('updateAfterTraffic').value = clientData.afterTraffic;
                        document.getElementById('updateBeforeRank').value = clientData.beforeRank;
                        document.getElementById('updateAfterRank').value = clientData.afterRank;
                        document.getElementById('updateAltText').value = clientData.altText;
                        document.getElementById('updateLink').value = clientData.link;

                        const serviceSelect = document.getElementById('serviceId');
                        Array.from(serviceSelect.options).forEach(option => {
                            option.selected = option.value == clientData.serviceId;
                        });

                        // Handle image preview
                        const imagePreview = document.querySelector('#currentImagePreview img');
                        if (clientData.imagePath) {
                            imagePreview.src = '/' + clientData.imagePath;
                            imagePreview.style.display = 'block';
                        } else {
                            imagePreview.style.display = 'none';
                        }
                    }

                    // Add click handlers to edit buttons
                    document.querySelectorAll('.edit-item-btn').forEach(button => {
                        button.addEventListener('click', function () {
                            const clientData = {
                                id: this.dataset.id,
                                title: this.dataset.title,
                                description: this.dataset.description,
                                altText: this.dataset.altText,
                                link: this.dataset.link,
                                imagePath: this.dataset.imagePath,
                                serviceId: this.dataset.service,
                                afterTraffic: this.dataset.afterTraffic,
                                beforeTraffic: this.dataset.beforeTraffic,
                                beforeRank: this.dataset.beforeRank,
                                afterRank: this.dataset.afterRank
                            };

                            updateClientModal(clientData);

                            const form = document.getElementById('updateForm');
                            form.action = `/portfolio-marketing/update/${clientData.id}`;
                        });
                    });
                });
            </script>