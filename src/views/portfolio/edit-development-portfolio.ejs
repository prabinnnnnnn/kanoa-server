<%- contentFor('HeaderCss') %>
    <!-- quill css -->
    <link href="/assets/libs/quill/quill.core.css" rel="stylesheet" type="text/css" />
    <link href="/assets/libs/quill/quill.bubble.css" rel="stylesheet" type="text/css" />
    <link href="/assets/libs/quill/quill.snow.css" rel="stylesheet" type="text/css" />
    <%- contentFor('body') %>
        <%- include ('../partials/messages') %>
            <div class="row">
                <div class="col-xl-12">
                    <div class="card">
                        <div class="card-body">
                            <!-- Nav tabs -->
                            <ul class="nav nav-tabs nav-tabs-custom nav-success nav-justified mb-3" role="tablist">
                                <li class="nav-item">
                                    <a class="nav-link active" data-bs-toggle="tab" href="#blogContent" role="tab">
                                        <i class="ri-pages-line align-middle me-1"></i> Details
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" data-bs-toggle="tab" href="#seo" role="tab">
                                        <i class="ri-file-search-line align-middle me-1"></i> About Client
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" data-bs-toggle="tab" href="#faq" role="tab">
                                        <i class="ri-question-line align-middle me-1"></i> Content
                                    </a>
                                </li>
                            </ul>

                            <!-- Tab panes -->
                            <div class="tab-content">

                                <div class="tab-pane active" id="blogContent" role="tabpanel">
                                    <form action="/portfolio-development/update/<%= data.id %>" id="serviceForm" method="post" onsubmit="updateContent(event);" enctype="multipart/form-data">
                                        <div class="d-flex">
                                            <div class="flex-grow-1 ms-2">
                                                <div class="mb-3">
                                                    <div class="card-body">

                                                        <div class="col-12 mb-3">
                                                            <label for="serviceId" class="form-label">Service</label>
                                                            <select class="form-select" id="serviceId" name="serviceId">
                                                                <% service.forEach(function(category) { %>
                                                                    <option value="<%= category.id %>"
                                                                        <%=data.serviceId===category.id ? 'selected' : '' %>>
                                                                        <%= category.title %>
                                                                    </option>
                                                                    <% }); %>
                                                            </select>

                                                        </div>
                                                        <div class="row gy-4">
                                                            <div class="col-md-6">
                                                                <label for="title" class="form-label">Title</label>
                                                                <input type="text" class="form-control" id="title"
                                                                    name="title" value="<%= data.title %>">
                                                            </div>
                                                            <div class="col-md-6">
                                                                <label for="slug" class="form-label">Slug</label>
                                                                <input type="text" class="form-control" id="slug"
                                                                    name="slug" value="<%= data.slug %>">
                                                            </div>
                                                            <div class="col-12">
                                                                <label for="coverImage" class="form-label">Current
                                                                    Image</label><br>
                                                                <img src="/<%= data.imagePath %>" alt="Cover Image"
                                                                    class="img-fluid mt-2"
                                                                    style="width: 100px; height: 100px;">
                                                            </div>

                                                            <div class="col-12">
                                                                <label for="imagePath" class="form-label">Cover
                                                                    Image</label>
                                                                <input type="file" class="form-control" id="imagePath"
                                                                    name="imagePath" accept="image/*"
                                                                    onchange="previewImage(event)">
                                                                <img id="imagePreview" src="#" alt="Image Preview"
                                                                    class="d-none mt-2 w-25 img-fluid" />
                                                            </div>
                                                            <div class="mb-3 col-6">
                                                                <label for="tags" class="form-label">Tags</label>
                                                                <input type="text" class="form-control" id="tags"
                                                                    name="tags" value="<%= data.tags %>">
                                                            </div>
                                                            <div class="mb-3 col-6">
                                                                <label for="link" class="form-label">Link</label>
                                                                <input type="text" class="form-control" id="link"
                                                                    name="url" value="<%= data.url %>">
                                                            </div>
                                                            <div class="mb-3 col-6">
                                                                <label for="altText" class="form-label">Alt Text</label>
                                                                <input type="text" class="form-control" id="altText"
                                                                    name="altText" value="<%= data.altText %>">
                                                            </div>
                                                            <div class="col-12">
                                                                <label for="description"
                                                                    class="form-label">Description</label>
                                                                <textarea name="description" id="description"
                                                                    class="form-control"
                                                                    rows="5"><%= data.description %></textarea>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="card card-body">
                                            <button type="submit" class="btn btn-secondary waves-effect col-md-3">Submit</button>
                                        </div>
                                    </form>
                                </div>

                                <div class="tab-pane" id="seo" role="tabpanel">
                                    <form action="/portfolio-development/update/<%= data.id %>" id="serviceForm" method="post" onsubmit="updateContent(event);" enctype="multipart/form-data">
                                        <div class="d-flex">
                                            <div class="flex-grow-1 ms-2">
                                                <div class="card-body">
                                                    <div class="row gy-4">
                                                        <div class="col-6">
                                                            <label for="coverImage" class="form-label">Website Demo
                                                                Image</label>
                                                            <input type="file" class="form-control" id="coverImage"
                                                                name="coverImage" accept="image/*">
                                                            <div class="mt-3">
                                                                <label for="coverImage" class="form-label">Current
                                                                    Image</label><br>
                                                                <img src="/<%= data.development_portfolio_about_client.coverImage %>"
                                                                    alt="Cover Image" class="img-fluid mt-2"
                                                                    style="width: 100px; height: 100px;">
                                                            </div>
                                                        </div>
                                                        <div class="col-6">
                                                            <label for="clientImage" class="form-label">client
                                                                Image</label>
                                                            <input type="file" class="form-control" id="clientImage"
                                                                name="clientImage" accept="image/*">
                                                            <div class="mt-3">
                                                                <label for="coverImage" class="form-label">Current
                                                                    Image</label><br>
                                                                <img src="/<%= data.development_portfolio_about_client.clientImage %>"
                                                                    alt="Cover Image" class="img-fluid mt-2"
                                                                    style="width: 100px; height: 100px;">
                                                            </div>
                                                        </div>
                                                        <div class="col-md-12">
                                                            <label for="seoDescription"
                                                                class="form-label">Description</label>
                                                            <textarea class="form-control" id="seoDescription"
                                                                name="client[description]"
                                                                rows="8"><%= data.development_portfolio_about_client.description %></textarea>
                                                        </div>

                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="card card-body">
                                            <button type="submit" class="btn btn-secondary waves-effect col-md-3">Submit</button>
                                        </div>
                                    </form>
                                </div>

                                <div class="tab-pane" id="faq" role="tabpanel">
                                    <div class="d-flex">
                                        <div class="flex-grow-1 ms-2">
                                            <fieldset>
                                                <legend class="mb-4">Development Portfolio Contents</legend>

                                                <div class="accordion mt-4" id="faqAccordion">
                                                    <% if(data.development_portfolio_contents &&
                                                        data.development_portfolio_contents.length> 0)
                                                        {
                                                        %>
                                                        <% data.development_portfolio_contents.forEach((content,
                                                            index)=> { %>
                                                            <div class="accordion-item content-item" id="content-item-<%= index %>">
                                                                <h2 class="accordion-header" id="heading<%= index %>">
                                                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse<%= index %>">
                                                                        <%= content.title %>
                                                                    </button>
                                                                </h2>

                                                                <div id="collapse<%= index %>" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                                                                    <div class="accordion-body">
                                                                        <form action="/portfolio-development-content/update/<%= content.id %>" method="post" id="serviceId" onsubmit="updateContent(event);" enctype="multipart/form-data">
                                                                            <div class="text-end">
                                                                                <button type="button" class="btn btn-danger btn-sm" onclick="handleRemoveContent('<%= content.id %>','content-item-<%= index %>')">
                                                                                    Remove
                                                                                </button>
                                                                                <button type="submit" class="btn btn-secondary btn-sm">
                                                                                    Update Content
                                                                                </button>
                                                                            </div>
                                                                            <div class="mb-3">
                                                                                <label class="form-label">Title</label>
                                                                                <input type="text" class="form-control" name="title" value="<%= content.title %>">
                                                                            </div>

                                                                            <div class="mb-3">
                                                                                <label class="form-label">Description</label>
                                                                                <textarea class="form-control" rows="5" name="description"><%= content.description %></textarea>
                                                                            </div>
                                                                            <div class="mb-3">
                                                                                <label class="form-label">Image</label>
                                                                                <input type="file" name="contentImages" class="form-control" accept="image/*">
                                                                            </div>

                                                                            <div class="mb-3">
                                                                                <label class="form-label">Current Image</label>
                                                                                <br>
                                                                                <img src="/<%= content.coverImage %>" width="100">
                                                                            </div>

                                                                            <div class="mb-3">
                                                                                <label class="form-label">Sort
                                                                                    Order</label>
                                                                                <input type="number" class="form-control" name="sortOrder" value="<%= content.sortOrder %>">
                                                                            </div>
                                                                        </form>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <% }) %>
                                                                <% } %>
                                                </div>
                                                <form action="/portfolio-development-contents/update/<%= data.id %>" method="post" id="serviceId" onsubmit="updateContent(event);" enctype="multipart/form-data">
                                                    <div id="editDevelopmentContentsContainer">
                                                    </div>
                                                    <div class="text-center mt-4">
                                                        <button type="button" class="btn btn-soft-primary waves-effect col-md-12" onclick="addDevelopmentPortfolioContent()">Add New Content</button>
                                                    </div>
                                                    <div class="card card-body">
                                                        <button type="submit" id="all-content-submit" class="btn btn-secondary waves-effect col-md-3">Submit Content</button>
                                                    </div>
                                                </form>
                                            </fieldset>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <%- contentFor('FooterJs') %>
                <script src="/assets/js/main/tinymce.js"></script>
                <script src="/assets/js/portfolio/edit.js"></script>