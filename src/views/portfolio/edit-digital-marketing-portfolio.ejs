<%- contentFor('HeaderCss') %>
    <!-- quill css -->
    <link href="/assets/libs/quill/quill.core.css" rel="stylesheet" type="text/css" />
    <link href="/assets/libs/quill/quill.bubble.css" rel="stylesheet" type="text/css" />
    <link href="/assets/libs/quill/quill.snow.css" rel="stylesheet" type="text/css" />
    <%- contentFor('body') %>

        <div class="row">
            <div class="col-xl-12">
                <%- include ('../partials/messages') %>
                    <div class="card">
                        <div class="card-body">
                            <!-- Nav tabs -->
                            <ul class="nav nav-tabs nav-tabs-custom nav-success nav-justified mb-3" role="tablist">
                                <li class="nav-item">
                                    <a class="nav-link active" data-bs-toggle="tab" href="#blogContent" role="tab">
                                        <i class="ri-pages-line align-middle me-1"></i> Details
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" data-bs-toggle="tab" href="#seo" role="tab">
                                        <i class="ri-file-search-line align-middle me-1"></i> About Client
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" data-bs-toggle="tab" href="#faq" role="tab">
                                        <i class="ri-question-line align-middle me-1"></i> Content
                                    </a>
                                </li>
                            </ul>

                            <!-- Tab panes -->
                            <div class="tab-content">
                                <div class="tab-pane active" id="blogContent" role="tabpanel">
                                    <form action="/portfolio-marketing/update/<%= data.id %>" id="serviceForm" method="post" onsubmit="updateContent(event);" enctype="multipart/form-data">
                                        <div class="d-flex">
                                            <div class="flex-grow-1 ms-2">
                                                <div class="mb-3">
                                                    <div class="card-body">

                                                        <div class="col-12 mb-3">
                                                            <label for="serviceId" class="form-label">Service</label>
                                                            <select class="form-select" id="serviceId" name="serviceId">
                                                                <% service.forEach(function(category) { %>
                                                                    <option value="<%= category.id %>"
                                                                        <%=data.serviceId===category.id ? 'selected' : '' %>>
                                                                        <%= category.title %>
                                                                    </option>
                                                                    <% }); %>
                                                            </select>

                                                        </div>
                                                        <div class="row gy-4">
                                                            <div class="col-md-6">
                                                                <label for="title" class="form-label">Title</label>
                                                                <input type="text" class="form-control" id="title"
                                                                    name="title" value="<%= data.title %>">
                                                            </div>
                                                            <div class="col-md-6">
                                                                <label for="slug" class="form-label">Slug</label>
                                                                <input type="text" class="form-control" id="slug"
                                                                    name="slug" value="<%= data.slug %>">
                                                            </div>
                                                            <div class="col-12">
                                                                <label for="coverImage" class="form-label">Current
                                                                    Image</label><br>
                                                                <img src="/<%= data.imagePath %>" alt="Cover Image"
                                                                    class="img-fluid mt-2"
                                                                    style="width: 100px; height: 100px;">
                                                            </div>

                                                            <div class="col-12">
                                                                <label for="imagePath" class="form-label">Cover
                                                                    Image</label>
                                                                <input type="file" class="form-control" id="imagePath"
                                                                    name="imagePath" accept="image/*"
                                                                    onchange="previewImage(event)">
                                                                <img id="imagePreview" src="#" alt="Image Preview"
                                                                    class="d-none mt-2 w-25 img-fluid" />
                                                            </div>
                                                            <div class="mb-3 col-md-6">
                                                                <label for="before-traffic" class="form-label">Before Traffic</label>
                                                                <input type="number" class="form-control" id="before-traffic" name="before_traffic" value="<%= data.before_traffic %>">
                                                            </div>
                                                            <div class="mb-3 col-md-6">
                                                                <label for="after-traffic" class="form-label">After Traffic</label>
                                                                <input type="number" class="form-control" id="after-traffic" name="after_traffic" value="<%= data.after_traffic %>" required>
                                                            </div>
                                                            <div class="mb-3 col-md-6">
                                                                <label for="before-rank" class="form-label">Before Rank</label>
                                                                <input type="number" class="form-control" id="before-rank" name="before_rank" value="<%= data.before_rank %>" required>
                                                            </div>
                                                            <div class="mb-3 col-md-6">
                                                                <label for="after-rank" class="form-label">After Rank</label>
                                                                <input type="number" class="form-control" id="after-rank" name="after_rank" value="<%= data.after_rank %>" required>
                                                            </div>
                                                            <div class="mb-3 col-6">
                                                                <label for="link" class="form-label">Link</label>
                                                                <input type="text" class="form-control" id="link" name="url" value="<%= data.url %>">
                                                            </div>
                                                            <div class="mb-3 col-6">
                                                                <label for="altText" class="form-label">Alt Text</label>
                                                                <input type="text" class="form-control" id="altText" name="altText" value="<%= data.altText %>" required>
                                                            </div>
                                                            <div class="col-12">
                                                                <label for="description" class="form-label">Description</label>
                                                                <textarea name="description" id="description" class="form-control" rows="5"><%= data.description %></textarea>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="card card-body">
                                            <button type="submit" class="btn btn-secondary waves-effect col-md-3">Submit</button>
                                        </div>
                                    </form>
                                </div>
                                <%=console.log(data)%>
                                    <div class="tab-pane" id="seo" role="tabpanel">
                                        <form action="/portfolio-marketing/update/<%= data.id %>" id="serviceForm" method="post" onsubmit="updateContent(event);" enctype="multipart/form-data">
                                            <div class="d-flex">
                                                <div class="flex-grow-1 ms-2">
                                                    <div class="card-body">
                                                        <div class="row gy-4">
                                                            <div class="col-6">
                                                                <label for="coverImage" class="form-label">Website Demo
                                                                    Image</label>
                                                                <input type="file" class="form-control" id="coverImage"
                                                                    name="coverImage" accept="image/*">
                                                                <div class="mt-3">
                                                                    <label for="coverImage" class="form-label">Current
                                                                        Image</label><br>
                                                                    <img src="/<%= data.digital_portfolio_about_client.coverImage %>"
                                                                        alt="Cover Image" class="img-fluid mt-2"
                                                                        style="width: 100px; height: 100px;">
                                                                </div>
                                                            </div>
                                                            <div class="col-6">
                                                                <label for="clientImage" class="form-label">client
                                                                    Image</label>
                                                                <input type="file" class="form-control" id="clientImage"
                                                                    name="clientImage" accept="image/*">
                                                                <div class="mt-3">
                                                                    <label for="coverImage" class="form-label">Current
                                                                        Image</label><br>
                                                                    <img src="/<%= data.digital_portfolio_about_client.clientImage %>"
                                                                        alt="Cover Image" class="img-fluid mt-2"
                                                                        style="width: 100px; height: 100px;">
                                                                </div>
                                                            </div>
                                                            <div class="col-md-12">
                                                                <label for="seoDescription"
                                                                    class="form-label">Description</label>
                                                                <textarea class="form-control" id="seoDescription"
                                                                    name="client[description]"
                                                                    rows="8"><%= data.digital_portfolio_about_client.description %></textarea>
                                                            </div>

                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="card card-body">
                                                <button type="submit" class="btn btn-secondary waves-effect col-md-3">Submit</button>
                                            </div>
                                        </form>
                                    </div>
                                    <div class="tab-pane" id="faq" role="tabpanel">
                                        <div class="d-flex">
                                            <div class="flex-grow-1 ms-2">
                                                <fieldset>
                                                    <legend class="mb-4">Digital Marketing Portfolio Contents</legend>

                                                    <div class="accordion mt-4" id="faqAccordion">
                                                        <% if(data.DigitalMarketingPortfolioContents &&
                                                            data.DigitalMarketingPortfolioContents.length> 0)
                                                            {
                                                            %>
                                                            <% data.DigitalMarketingPortfolioContents.forEach((content,
                                                                index)=> { %>
                                                                <div class="accordion-item content-item" id="content-item-<%= index %>">
                                                                    <h2 class="accordion-header" id="heading<%= index %>">
                                                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse<%= index %>">
                                                                            <%= content.title %>
                                                                        </button>
                                                                    </h2>

                                                                    <div id="collapse<%= index %>" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                                                                        <div class="accordion-body">
                                                                            <form action="/portfolio-marketing-content/update/<%= content.id %>" method="post" id="serviceId" onsubmit="updateContent(event);" enctype="multipart/form-data">
                                                                                <div class="text-end">
                                                                                    <button type="button" class="btn btn-danger btn-sm" onclick="handleRemoveDigitalMarketingContent('<%= content.id %>','content-item-<%= index %>')">
                                                                                        Remove
                                                                                    </button>
                                                                                    <button type="submit" class="btn btn-secondary btn-sm">
                                                                                        Update Content
                                                                                    </button>
                                                                                </div>
                                                                                <div class="mb-3">
                                                                                    <label class="form-label">Title</label>
                                                                                    <input type="text" class="form-control" name="title" value="<%= content.title %>">
                                                                                </div>

                                                                                <div class="mb-3">
                                                                                    <label class="form-label">Description</label>
                                                                                    <textarea class="form-control" rows="5" name="description"><%= content.description %></textarea>
                                                                                </div>
                                                                                <div class="mb-3">
                                                                                    <label class="form-label">Image</label>
                                                                                    <input type="file" name="contentImages" class="form-control" accept="image/*">
                                                                                </div>

                                                                                <div class="mb-3">
                                                                                    <label class="form-label">Current Image</label>
                                                                                    <br>
                                                                                    <img src="/<%= content.coverImage %>" width="100">
                                                                                </div>

                                                                                <div class="mb-3">
                                                                                    <label class="form-label">Sort
                                                                                        Order</label>
                                                                                    <input type="number" class="form-control" name="sortOrder" value="<%= content.sortOrder %>">
                                                                                </div>
                                                                            </form>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <% }) %>
                                                                    <% } %>
                                                    </div>
                                                    <form action="/portfolio-marketing-contents/update/<%= data.id %>" method="post" id="serviceId" onsubmit="updateContent(event);" enctype="multipart/form-data">
                                                        <div id="editDevelopmentContentsContainer">
                                                        </div>
                                                        <div class="text-center mt-4">
                                                            <button type="button"
                                                                class="btn btn-soft-primary waves-effect col-md-12"
                                                                onclick="addDevelopmentPortfolioContent()">Add New
                                                                Content</button>
                                                        </div>
                                                        <div class="card card-body">
                                                            <button type="submit" id="all-content-submit" class="btn btn-secondary waves-effect col-md-3">Submit Content</button>
                                                        </div>
                                                    </form>
                                                </fieldset>
                                            </div>
                                        </div>

                                    </div>
                            </div>

                        </div>
                    </div>
            </div>
        </div><!-- end col -->
        </div><!-- end row -->

        <%- contentFor('FooterJs') %>
            <script src="/assets/js/main/tinymce.js"></script>
            <script src="/assets/js/portfolio/edit.js"></script>